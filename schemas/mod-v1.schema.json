{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crimsoncrossbunker.github.io/CCB-MOD/schemas/mod-v1.schema.json",
  "title": "CCB MOD catalog entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "type", "name", "description", "version",
    "authors", "maintainers", "ccb_adapters", "license", "source", "issues",
    "ccb_versions", "dependencies", "conflicts", "updated_at", "validation"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,63}$"},
    "type": {"enum": ["ccb-maintained", "community"]},
    "name": {"$ref": "#/$defs/localizedText"},
    "description": {"$ref": "#/$defs/localizedText"},
    "play_notes": {"$ref": "#/$defs/localizedText"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"},
    "authors": {"$ref": "#/$defs/people"},
    "maintainers": {"$ref": "#/$defs/people"},
    "ccb_adapters": {"$ref": "#/$defs/people"},
    "license": {"type": "string", "minLength": 1},
    "source": {"type": "string", "format": "uri", "pattern": "^https://"},
    "issues": {"type": "string", "format": "uri", "pattern": "^https://"},
    "ccb_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "lua_api": {"type": "integer", "minimum": 1},
    "dependencies": {"$ref": "#/$defs/modIds"},
    "conflicts": {"$ref": "#/$defs/modIds"},
    "download": {"type": "string", "format": "uri", "pattern": "^https://"},
    "updated_at": {"type": "string", "format": "date"},
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ccb_version", "checked_at"],
      "properties": {
        "status": {"enum": ["passed", "failed", "not-tested"]},
        "ccb_version": {"type": ["string", "null"]},
        "checked_at": {"type": ["string", "null"], "format": "date"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "community"}}}, "then": {"required": ["download"]}}
  ],
  "$defs": {
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "zh-Hans": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    },
    "people": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "modIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
